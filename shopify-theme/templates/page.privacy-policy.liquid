<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Privacy Policy — RedGuard</title>
  <link rel="icon" href="https://dashboard.redgaurd.com/favicon.ico" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --red: #dc2626; --bg: #0a0a0f; --bg2: #0d0d14; --border: #1e1e2e; --text: #f1f5f9; --muted: #64748b; --sub: #94a3b8; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); line-height: 1.7; -webkit-font-smoothing: antialiased; }
    a { color: var(--red); text-decoration: none; }
    a:hover { text-decoration: underline; }
    nav { display: flex; align-items: center; justify-content: space-between; padding: 0 40px; height: 64px; background: rgba(10,10,15,0.9); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); }
    .nav-logo-icon { width: 32px; height: 32px; border-radius: 8px; background: var(--red); display: flex; align-items: center; justify-content: center; }
    .nav-brand { font-size: 17px; font-weight: 700; }
    .container { max-width: 740px; margin: 0 auto; padding: 64px 40px 96px; }
    .page-label { font-size: 12px; font-weight: 700; color: var(--red); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 12px; }
    h1 { font-size: 36px; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 8px; }
    .updated { font-size: 14px; color: var(--muted); margin-bottom: 48px; }
    h2 { font-size: 20px; font-weight: 700; margin: 40px 0 12px; }
    p { font-size: 15px; color: var(--sub); margin-bottom: 16px; }
    ul { padding-left: 20px; margin-bottom: 16px; }
    li { font-size: 15px; color: var(--sub); margin-bottom: 8px; }
    .highlight-box { background: var(--bg2); border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 8px; padding: 20px 24px; margin: 24px 0; }
    .highlight-box p { margin: 0; }
    footer { text-align: center; padding: 32px; border-top: 1px solid var(--border); font-size: 13px; color: var(--muted); }
    @media (max-width: 600px) { nav { padding: 0 20px; } .container { padding: 40px 20px 64px; } h1 { font-size: 28px; } }
  </style>
</head>
