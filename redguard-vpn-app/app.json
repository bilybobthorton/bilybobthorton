{
  "expo": {
    "name": "RedGuard VPN",
    "slug": "redguard-vpn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "redguardvpn",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#07070e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.redgaurd.vpn",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "RedGuard VPN requires local network access to establish VPN tunnels."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07070e"
      },
      "package": "com.redgaurd.vpn",
      "permissions": [
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
