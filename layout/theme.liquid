<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07070e">
  <title>
    {{ page_title }}
    {%- if page_title != shop.name %} — {{ shop.name }}{% endif %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

  {%- assign app_url = 'https://dashboard.redgaurd.com' -%}

  <header class="site-header" id="site-header">
    <div class="container header-inner">
      <a href="{{ routes.root_url }}" class="logo">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="24" height="24" rx="6" fill="#dc2626"/>
          <path d="M12 4.5L19 7.5V13c0 3.5-2.8 6.5-7 7.5C7.8 19.5 5 16.5 5 13V7.5L12 4.5Z" fill="white" opacity="0.15"/>
          <path d="M9 12.75L11.25 15 15 9.75" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="logo-text">RedGuard</span>
      </a>

      <nav class="site-nav" id="site-nav">
        <a href="#features" class="nav-link">Features</a>
        <a href="#pricing" class="nav-link">Pricing</a>
        <a href="#vpn" class="nav-link">VPN</a>
        <a href="{{ app_url }}/download" class="nav-link">Download</a>
      </nav>

      <div class="header-actions">
        <a href="{{ app_url }}/login" class="btn btn-ghost">Log in</a>
        <a href="{{ app_url }}/register" class="btn btn-primary">Start free</a>
      </div>

      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
