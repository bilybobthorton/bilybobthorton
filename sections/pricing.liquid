<section class="section pricing-section" id="pricing">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">Pricing</p>
      <h2 class="section-title">Simple, transparent pricing</h2>
      <p class="section-subtitle">Start free. Upgrade when you need more power. Cancel anytime.</p>
    </div>

    <div class="pricing-grid">
      <!-- Free -->
      <div class="pricing-card">
        <div class="plan-header">
          <h3 class="plan-name">Free</h3>
          <div class="plan-price">
            <span class="price-amount">$0</span>
            <span class="price-period">/mo</span>
          </div>
          <p class="plan-desc">Get started with essential malware scanning at no cost.</p>
        </div>
        <ul class="plan-features">
          <li><span class="check">✓</span> 5 scans per day</li>
          <li><span class="check">✓</span> Static PE analysis</li>
          <li><span class="check">✓</span> SHA256 hash lookup</li>
          <li><span class="check">✓</span> Local hash database</li>
          <li><span class="check">✓</span> Basic threat verdict</li>
          <li class="muted"><span class="dash">—</span> ML scoring</li>
          <li class="muted"><span class="dash">—</span> VirusTotal cross-check</li>
          <li class="muted"><span class="dash">—</span> OTX enrichment</li>
          <li class="muted"><span class="dash">—</span> YARA rules</li>
          <li class="muted"><span class="dash">—</span> PDF reports</li>
          <li class="muted"><span class="dash">—</span> Endpoint agent</li>
        </ul>
        <a href="https://app.redgaurd.com/register" class="btn btn-outline btn-block">Get started free</a>
      </div>

      <!-- Pro -->
      <div class="pricing-card pricing-card-featured">
        <div class="plan-badge">Most Popular</div>
        <div class="plan-header">
          <h3 class="plan-name">Pro</h3>
          <div class="plan-price">
            <span class="price-amount">$9.99</span>
            <span class="price-period">/mo</span>
          </div>
          <p class="plan-desc">Full detection stack for security professionals and power users.</p>
        </div>
        <ul class="plan-features">
          <li><span class="check">✓</span> Unlimited scans</li>
          <li><span class="check">✓</span> All static analysis</li>
          <li><span class="check">✓</span> <strong>ML scoring</strong> (31 features)</li>
          <li><span class="check">✓</span> <strong>VirusTotal</strong> 70+ engines</li>
          <li><span class="check">✓</span> <strong>OTX threat enrichment</strong></li>
          <li><span class="check">✓</span> <strong>Behavioral heuristics</strong></li>
          <li><span class="check">✓</span> <strong>Custom YARA rules</strong></li>
          <li><span class="check">✓</span> <strong>PDF reports</strong></li>
          <li><span class="check">✓</span> <strong>Endpoint agent</strong></li>
          <li><span class="check">✓</span> Webhook notifications</li>
          <li><span class="check">✓</span> 14-day free trial</li>
        </ul>
        <a href="https://app.redgaurd.com/register" class="btn btn-primary btn-block">Start 14-day trial</a>
        <p class="plan-note">No credit card required for trial</p>
      </div>

      <!-- Enterprise -->
      <div class="pricing-card">
        <div class="plan-header">
          <h3 class="plan-name">Enterprise</h3>
          <div class="plan-price">
            <span class="price-amount">$99</span>
            <span class="price-period">/mo+</span>
          </div>
          <p class="plan-desc">API-first deployment for security teams and MSSPs.</p>
        </div>
        <ul class="plan-features">
          <li><span class="check">✓</span> Everything in Pro</li>
          <li><span class="check">✓</span> <strong>Full REST API access</strong></li>
          <li><span class="check">✓</span> <strong>MISP integration</strong></li>
          <li><span class="check">✓</span> <strong>Network IOC enrichment</strong></li>
          <li><span class="check">✓</span> <strong>SIEM webhook streams</strong></li>
          <li><span class="check">✓</span> <strong>Multi-agent deployment</strong></li>
          <li><span class="check">✓</span> Dedicated support SLA</li>
          <li><span class="check">✓</span> Custom scan quotas</li>
          <li><span class="check">✓</span> Priority queue</li>
          <li><span class="check">✓</span> On-prem option</li>
          <li><span class="check">✓</span> Compliance reports</li>
        </ul>
        <a href="mailto:sales@redgaurd.com" class="btn btn-outline btn-block">Contact sales</a>
      </div>
    </div>

    <!-- VPN Pricing add-on -->
    <div class="vpn-pricing-row">
      <div class="vpn-pricing-header">
        <h3>Add SentinelVPN</h3>
        <p>WireGuard VPN with threat-aware DNS. Bundle with Pro for maximum protection at 30% off.</p>
      </div>
      <div class="vpn-plans">
        <div class="vpn-plan">
          <span class="vpn-plan-name">VPN Free</span>
          <span class="vpn-plan-price">$0/mo</span>
          <span class="vpn-plan-detail">1 location · 10 GB · 1 device</span>
        </div>
        <div class="vpn-plan">
          <span class="vpn-plan-name">VPN Pro</span>
          <span class="vpn-plan-price">$4.99/mo</span>
          <span class="vpn-plan-detail">All locations · Unlimited · 5 devices</span>
        </div>
        <div class="vpn-plan vpn-plan-featured">
          <span class="vpn-plan-badge">Best value</span>
          <span class="vpn-plan-name">Security Bundle</span>
          <span class="vpn-plan-price">$12.99/mo</span>
          <span class="vpn-plan-detail">VPN Pro + SentinelCore Pro · Save 30%</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pricing",
  "settings": []
}
{% endschema %}
