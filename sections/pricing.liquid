<section class="section pricing-section" id="pricing">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">Pricing</p>
      <h2 class="section-title">Start free. Upgrade when you're ready.</h2>
      <p class="section-subtitle">No contracts. Cancel anytime. Plans billed monthly.</p>
    </div>

    <div class="pricing-grid">
      <!-- Free -->
      <div class="pricing-card">
        <div class="plan-header">
          <h3 class="plan-name">Free</h3>
          <div class="plan-price">
            <span class="price-amount">$0</span>
            <span class="price-period">/mo</span>
          </div>
          <p class="plan-desc">Try RedGuard free. Includes a 7-day VPN trial to see what you're missing.</p>
        </div>
        <ul class="plan-features">
          <li><span class="check">✓</span> Basic malware scanning (5/day)</li>
          <li><span class="check">✓</span> Local hash reputation check</li>
          <li><span class="check">✓</span> 7-day VPN trial included</li>
          <li><span class="check">✓</span> 1 device</li>
          <li class="muted"><span class="dash">—</span> Unlimited scans</li>
          <li class="muted"><span class="dash">—</span> ML threat scoring</li>
          <li class="muted"><span class="dash">—</span> VPN after trial</li>
        </ul>
        <a href="https://dashboard.redgaurd.com/register" class="btn btn-outline btn-block">Start free trial</a>
      </div>

      <!-- Security Bundle (featured) -->
      <div class="pricing-card pricing-card-featured">
        <div class="plan-badge">Most Popular</div>
        <div class="plan-header">
          <h3 class="plan-name">Security Bundle</h3>
          <div class="plan-price">
            <span class="price-amount">$12.99</span>
            <span class="price-period">/mo</span>
          </div>
          <p class="plan-desc">Full antivirus + VPN in one subscription. 30% off vs. buying separately.</p>
        </div>
        <ul class="plan-features">
          <li><span class="check">✓</span> Unlimited malware scans</li>
          <li><span class="check">✓</span> <strong>ML threat scoring</strong></li>
          <li><span class="check">✓</span> <strong>VirusTotal</strong> 70+ engines</li>
          <li><span class="check">✓</span> <strong>Custom YARA rules</strong></li>
          <li><span class="check">✓</span> <strong>VPN Pro</strong> — unlimited bandwidth</li>
          <li><span class="check">✓</span> All server locations</li>
          <li><span class="check">✓</span> 5 devices</li>
          <li><span class="check">✓</span> PDF threat reports</li>
          <li><span class="check">✓</span> Priority support</li>
        </ul>
        <a href="/products/security-bundle" class="btn btn-primary btn-block">Get the Bundle</a>
        <p class="plan-note">No credit card required for trial</p>
      </div>

      <!-- Antivirus Pro -->
      <div class="pricing-card">
        <div class="plan-header">
          <h3 class="plan-name">Antivirus Pro</h3>
          <div class="plan-price">
            <span class="price-amount">$9.99</span>
            <span class="price-period">/mo</span>
          </div>
          <p class="plan-desc">Full malware protection without the VPN. For users who already have a VPN.</p>
        </div>
        <ul class="plan-features">
          <li><span class="check">✓</span> Unlimited malware scans</li>
          <li><span class="check">✓</span> <strong>ML threat scoring</strong></li>
          <li><span class="check">✓</span> <strong>VirusTotal</strong> 70+ engines</li>
          <li><span class="check">✓</span> <strong>OTX threat enrichment</strong></li>
          <li><span class="check">✓</span> <strong>Custom YARA rules</strong></li>
          <li><span class="check">✓</span> PDF threat reports</li>
          <li><span class="check">✓</span> Email alerts</li>
          <li class="muted"><span class="dash">—</span> VPN included</li>
        </ul>
        <a href="/products/redguard-pro" class="btn btn-outline btn-block">Get Antivirus Pro</a>
      </div>
    </div>

    <p style="text-align:center;font-size:13px;color:#64748b;margin-top:24px;">
      Need enterprise? <a href="mailto:enterprise@redgaurd.com" style="color:#94a3b8;">Contact us</a> for custom pricing, dedicated nodes, and SLA.
    </p>
  </div>
</section>

