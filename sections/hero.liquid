<section class="hero" id="hero">
  <div class="hero-bg">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
  </div>
  <div class="container hero-inner">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Free 7-day VPN trial — no credit card
    </div>
    <h1 class="hero-title">
      Real antivirus.<br>
      <span class="gradient-text">Real VPN.</span><br>
      One silent app.
    </h1>
    <p class="hero-subtitle">
      RedGuard runs quietly in the background — scanning threats in real time and encrypting
      your traffic with military-grade WireGuard encryption. Windows 10 &amp; 11.
    </p>
    <div class="hero-actions">
      <a href="https://dashboard.redgaurd.com/register" class="btn btn-primary btn-lg">
        Start free trial →
      </a>
      <a href="https://dashboard.redgaurd.com/download" class="btn btn-outline btn-lg">
        Download for Windows
      </a>
    </div>
    <p class="hero-note">~15 MB · No credit card required · Windows 10 / 11 64-bit</p>

    <div class="hero-scan-demo">
      <div class="scan-window">
        <div class="scan-window-bar">
          <span class="win-dot red"></span>
          <span class="win-dot yellow"></span>
          <span class="win-dot green"></span>
          <span class="win-title">RedGuard — Protected</span>
        </div>
        <div class="scan-window-body">
          <div class="scan-row">
            <span class="scan-label">Status</span>
            <span class="scan-value" style="color:#22c55e">● Protected</span>
          </div>
          <div class="scan-row">
            <span class="scan-label">Files scanned</span>
            <span class="scan-value">1,247 this session</span>
          </div>
          <div class="scan-divider"></div>
          <div class="scan-layers">
            <div class="layer-row complete">
              <span class="layer-icon">✓</span>
              <span class="layer-name">Hash Blocklist</span>
              <span class="layer-result clean">6,000+ signatures</span>
            </div>
            <div class="layer-row complete">
              <span class="layer-icon">✓</span>
              <span class="layer-name">PE Heuristics</span>
              <span class="layer-result clean">Entropy + packers</span>
            </div>
            <div class="layer-row complete">
              <span class="layer-icon">✓</span>
              <span class="layer-name">ML Engine</span>
              <span class="layer-result suspicious">Suspicious · 0.83</span>
            </div>
            <div class="layer-row complete">
              <span class="layer-icon">✓</span>
              <span class="layer-name">VirusTotal</span>
              <span class="layer-result malicious">18/71 engines</span>
            </div>
          </div>
          <div class="scan-verdict malicious">
            <span class="verdict-icon">⚠</span>
            MALICIOUS — Quarantined automatically
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": []
}
{% endschema %}
