<section class="hero" id="hero">
  <div class="hero-bg">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
  </div>
  <div class="container hero-inner">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Military-Grade Endpoint Security
    </div>
    <h1 class="hero-title">
      Stop Malware Before<br>
      <span class="gradient-text">It Stops You</span>
    </h1>
    <p class="hero-subtitle">
      5-layer deep inspection: local hash database, machine learning, VirusTotal, AlienVault OTX,
      and behavioral heuristics — all in seconds. Free forever, no credit card required.
    </p>
    <div class="hero-actions">
      <a href="https://app.redgaurd.com/register" class="btn btn-primary btn-lg">
        Start scanning free →
      </a>
      <a href="https://app.redgaurd.com/scan" class="btn btn-outline btn-lg">
        Try the scanner
      </a>
    </div>
    <p class="hero-note">Free plan · 5 scans/day · No credit card</p>

    <div class="hero-scan-demo">
      <div class="scan-window">
        <div class="scan-window-bar">
          <span class="win-dot red"></span>
          <span class="win-dot yellow"></span>
          <span class="win-dot green"></span>
          <span class="win-title">RedGuard Scanner</span>
        </div>
        <div class="scan-window-body">
          <div class="scan-row">
            <span class="scan-label">File</span>
            <span class="scan-value">suspicious_update.exe</span>
          </div>
          <div class="scan-row">
            <span class="scan-label">SHA256</span>
            <span class="scan-value mono">a1b2c3d4e5f6…</span>
          </div>
          <div class="scan-divider"></div>
          <div class="scan-layers">
            <div class="layer-row complete">
              <span class="layer-icon">✓</span>
              <span class="layer-name">Hash DB</span>
              <span class="layer-result clean">Clean</span>
            </div>
            <div class="layer-row complete">
              <span class="layer-icon">✓</span>
              <span class="layer-name">ML Engine</span>
              <span class="layer-result suspicious">Suspicious · 0.83</span>
            </div>
            <div class="layer-row complete">
              <span class="layer-icon">✓</span>
              <span class="layer-name">VirusTotal</span>
              <span class="layer-result malicious">18/71 engines</span>
            </div>
            <div class="layer-row complete">
              <span class="layer-icon">✓</span>
              <span class="layer-name">OTX Intel</span>
              <span class="layer-result malicious">4 pulses</span>
            </div>
            <div class="layer-row complete">
              <span class="layer-icon">✓</span>
              <span class="layer-name">Heuristics</span>
              <span class="layer-result malicious">T1055 · T1486</span>
            </div>
          </div>
          <div class="scan-verdict malicious">
            <span class="verdict-icon">⚠</span>
            MALICIOUS — Threat detected
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": []
}
{% endschema %}
