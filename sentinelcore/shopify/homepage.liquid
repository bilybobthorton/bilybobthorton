{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RedGuard — Antivirus + VPN. One Silent App.</title>
  <meta name="description" content="RedGuard combines real-time malware detection and WireGuard VPN into one lightweight Windows app. Start free — 7-day VPN trial included." />
  <link rel="icon" href="https://dashboard.redgaurd.com/favicon.ico" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --red:    #dc2626;
      --red-d:  #b91c1c;
      --green:  #22c55e;
      --bg:     #0a0a0f;
      --bg2:    #0d0d14;
      --bg3:    #111118;
      --border: #1e1e2e;
      --text:   #f1f5f9;
      --muted:  #64748b;
      --sub:    #94a3b8;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    a { text-decoration: none; color: inherit; }

    /* ── NAV ── */
    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 40px; height: 64px;
      background: rgba(10,10,15,0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo { display: flex; align-items: center; gap: 10px; }
    .nav-logo-icon {
      width: 32px; height: 32px; border-radius: 8px;
      background: var(--red); display: flex; align-items: center; justify-content: center;
    }
    .nav-brand { font-size: 17px; font-weight: 700; letter-spacing: -0.02em; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a { font-size: 14px; color: var(--sub); transition: color .15s; }
    .nav-links a:hover { color: var(--text); }
    .btn-nav {
      padding: 8px 18px; background: var(--red); color: #fff;
      border-radius: 7px; font-size: 14px; font-weight: 600;
      transition: background .15s;
    }
    .btn-nav:hover { background: var(--red-d); }

    /* ── LAYOUT ── */
    section { padding: 96px 40px; max-width: 1100px; margin: 0 auto; }

    /* ── BUTTONS ── */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 32px; background: var(--red); color: #fff;
      border-radius: 10px; font-size: 16px; font-weight: 700;
      transition: background .15s, transform .1s;
    }
    .btn-primary:hover { background: var(--red-d); transform: translateY(-1px); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 14px 32px; background: transparent; color: var(--text);
      border: 1px solid var(--border); border-radius: 10px;
      font-size: 16px; font-weight: 600; transition: border-color .15s;
    }
    .btn-secondary:hover { border-color: var(--sub); }

    /* ── HERO ── */
    .hero {
      text-align: center;
      padding-top: 120px; padding-bottom: 80px;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 14px; border-radius: 99px;
      border: 1px solid #7f1d1d; background: #1c0a0a;
      font-size: 12px; font-weight: 600; color: #fca5a5;
      margin-bottom: 28px; letter-spacing: 0.04em; text-transform: uppercase;
    }
    .hero h1 {
      font-size: clamp(36px, 6vw, 72px);
      font-weight: 800; letter-spacing: -0.04em; line-height: 1.05;
      margin-bottom: 24px;
    }
    .hero h1 span { color: var(--red); }
    .hero p {
      font-size: clamp(16px, 2vw, 20px); color: var(--sub);
      max-width: 560px; margin: 0 auto 40px;
    }
    .hero-ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .hero-note { font-size: 13px; color: var(--muted); margin-top: 20px; }

    /* ── TRUST BAR ── */
    .trust-bar {
      background: var(--bg2);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 20px 40px;
    }
    .trust-inner {
      max-width: 1100px; margin: 0 auto;
      display: flex; align-items: center; justify-content: center;
      gap: 40px; flex-wrap: wrap;
    }
    .trust-item {
      display: flex; align-items: center; gap: 8px;
      font-size: 13px; font-weight: 600; color: var(--sub);
    }
    .trust-item svg { color: var(--green); flex-shrink: 0; }

    /* ── STATS BAR ── */
    .stats-bar {
      background: var(--bg3);
      border-bottom: 1px solid var(--border);
      padding: 40px;
    }
    .stats-inner {
      max-width: 1100px; margin: 0 auto;
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 32px; text-align: center;
    }
    .stat-num {
      font-size: 36px; font-weight: 800; letter-spacing: -0.03em;
      color: var(--text);
    }
    .stat-num span { color: var(--red); }
    .stat-label { font-size: 13px; color: var(--muted); margin-top: 4px; }

    /* ── SECTION LABELS ── */
    .section-label {
      font-size: 12px; font-weight: 700; color: var(--red);
      text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 12px;
    }
    .section-title {
      font-size: clamp(26px, 4vw, 40px); font-weight: 800;
      letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 16px;
    }
    .section-sub { font-size: 16px; color: var(--sub); max-width: 520px; }

    /* ── HOW IT WORKS ── */
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 48px; }
    .step { padding: 32px; background: var(--bg2); border: 1px solid var(--border); border-radius: 16px; }
    .step-num {
      width: 40px; height: 40px; border-radius: 10px;
      background: #1c0a0a; border: 1px solid #7f1d1d;
      color: var(--red); font-size: 18px; font-weight: 800;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 20px;
    }
    .step h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; }
    .step p { font-size: 14px; color: var(--sub); line-height: 1.6; }

    /* ── FEATURES ── */
    .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
    .feature-card {
      padding: 28px; background: var(--bg); border: 1px solid var(--border);
      border-radius: 14px; transition: border-color .2s;
    }
    .feature-card:hover { border-color: #3f1f1f; }
    .feature-icon {
      width: 44px; height: 44px; background: #1c0a0a; border: 1px solid #7f1d1d;
      border-radius: 10px; display: flex; align-items: center; justify-content: center;
      color: var(--red); margin-bottom: 18px;
    }
    .feature-icon svg { width: 22px; height: 22px; }
    .feature-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
    .feature-card p { font-size: 14px; color: var(--sub); line-height: 1.6; }

    /* ── COMPARISON TABLE ── */
    .compare-wrap { margin-top: 48px; overflow-x: auto; }
    .compare-table {
      width: 100%; border-collapse: collapse;
      background: var(--bg2); border-radius: 16px; overflow: hidden;
      border: 1px solid var(--border);
    }
    .compare-table th {
      padding: 20px 24px; text-align: center;
      font-size: 14px; font-weight: 700; color: var(--sub);
      border-bottom: 1px solid var(--border);
      background: var(--bg3);
    }
    .compare-table th.highlight {
      background: #1a0808; color: var(--text);
      border-left: 1px solid #7f1d1d; border-right: 1px solid #7f1d1d;
    }
    .compare-table th.highlight .th-price {
      display: block; font-size: 22px; font-weight: 800;
      color: var(--red); margin-top: 4px; letter-spacing: -0.02em;
    }
    .compare-table td {
      padding: 14px 24px; font-size: 14px; color: var(--sub);
      border-bottom: 1px solid var(--border); text-align: center;
    }
    .compare-table td:first-child { text-align: left; font-weight: 500; color: var(--text); }
    .compare-table td.highlight {
      background: #0f0505;
      border-left: 1px solid #3f1010; border-right: 1px solid #3f1010;
      color: var(--text); font-weight: 600;
    }
    .compare-table tr:last-child td { border-bottom: none; }
    .yes { color: var(--green); font-weight: 700; }
    .no  { color: var(--muted); }
    .compare-note {
      text-align: center; font-size: 13px; color: var(--muted); margin-top: 16px;
    }

    /* ── PRICING ── */
    .pricing-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 24px; margin-top: 48px; align-items: start;
    }
    .pricing-card {
      padding: 32px; background: var(--bg2); border: 1px solid var(--border);
      border-radius: 16px; position: relative;
    }
    .pricing-card.featured {
      border-color: var(--red);
      background: linear-gradient(160deg, #1c0a0a 0%, var(--bg2) 100%);
    }
    .pricing-badge {
      display: inline-block; padding: 4px 12px; background: var(--red);
      color: #fff; font-size: 11px; font-weight: 700; border-radius: 99px;
      text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 16px;
    }
    .pricing-name { font-size: 14px; font-weight: 700; color: var(--sub); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
    .pricing-price { font-size: 48px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; margin-bottom: 8px; }
    .pricing-price sup { font-size: 20px; vertical-align: super; }
    .pricing-price span { font-size: 16px; font-weight: 400; color: var(--muted); }
    .pricing-desc { font-size: 13px; color: var(--sub); margin-bottom: 24px; min-height: 40px; }
    .pricing-features { list-style: none; margin-bottom: 28px; display: flex; flex-direction: column; gap: 10px; }
    .pricing-features li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--sub); }
    .pricing-features li::before { content: "✓"; color: var(--green); font-weight: 700; flex-shrink: 0; }
    .pricing-features li.no::before { content: "✕"; color: var(--muted); }
    .pricing-features li.no { color: var(--muted); }
    .btn-plan {
      display: block; text-align: center; width: 100%; padding: 13px;
      border-radius: 9px; font-size: 15px; font-weight: 700; transition: all .15s;
    }
    .btn-plan-primary { background: var(--red); color: #fff; }
    .btn-plan-primary:hover { background: var(--red-d); }
    .btn-plan-outline { background: transparent; border: 1px solid var(--border); color: var(--text); }
    .btn-plan-outline:hover { border-color: var(--sub); }
    .guarantee-note {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      font-size: 13px; color: var(--muted); margin-top: 28px;
    }
    .guarantee-note svg { color: var(--green); flex-shrink: 0; }

    /* ── TESTIMONIALS ── */
    .testimonials-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 24px; margin-top: 48px;
    }
    .testimonial-card {
      padding: 28px; background: var(--bg2); border: 1px solid var(--border);
      border-radius: 14px;
    }
    .stars { color: #f59e0b; font-size: 16px; margin-bottom: 14px; letter-spacing: 2px; }
    .testimonial-text { font-size: 15px; color: var(--sub); line-height: 1.7; margin-bottom: 20px; font-style: italic; }
    .testimonial-author { display: flex; align-items: center; gap: 12px; }
    .author-avatar {
      width: 38px; height: 38px; border-radius: 50%;
      background: var(--bg3); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; font-weight: 700; color: var(--red);
    }
    .author-name { font-size: 14px; font-weight: 700; }
    .author-role { font-size: 12px; color: var(--muted); }

    /* ── FAQ ── */
    .faq-list { margin-top: 48px; display: flex; flex-direction: column; gap: 2px; }
    .faq-item {
      background: var(--bg2); border: 1px solid var(--border); border-radius: 12px;
      overflow: hidden;
    }
    .faq-q {
      padding: 20px 24px; font-size: 15px; font-weight: 600;
      cursor: pointer; display: flex; align-items: center; justify-content: space-between;
      gap: 16px; user-select: none;
    }
    .faq-q:hover { color: var(--red); }
    .faq-icon { font-size: 20px; color: var(--muted); flex-shrink: 0; transition: transform .2s; }
    .faq-a {
      padding: 0 24px 20px; font-size: 14px; color: var(--sub); line-height: 1.7;
      display: none;
    }
    .faq-item.open .faq-a { display: block; }
    .faq-item.open .faq-icon { transform: rotate(45deg); color: var(--red); }

    /* ── DOWNLOAD CTA ── */
    .download-cta {
      background: linear-gradient(135deg, #1a0808 0%, #0d0d14 60%);
      border-top: 1px solid #3f1010; border-bottom: 1px solid #3f1010;
      text-align: center; padding: 96px 40px;
    }
    .download-cta h2 {
      font-size: clamp(28px, 4vw, 48px); font-weight: 800;
      letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 16px;
    }
    .download-cta p { font-size: 16px; color: var(--sub); margin-bottom: 40px; }
    .cta-guarantee {
      display: flex; align-items: center; justify-content: center; gap: 24px;
      flex-wrap: wrap; margin-top: 24px;
    }
    .cta-guarantee span {
      display: flex; align-items: center; gap: 6px;
      font-size: 13px; color: var(--muted);
    }
    .cta-guarantee svg { color: var(--green); }

    /* ── FOOTER ── */
    footer {
      background: var(--bg2); border-top: 1px solid var(--border);
      padding: 40px; display: flex; align-items: center;
      justify-content: space-between; flex-wrap: wrap; gap: 20px;
    }
    footer p { font-size: 13px; color: var(--muted); margin-top: 6px; }
    .footer-links { display: flex; gap: 24px; flex-wrap: wrap; }
    .footer-links a { font-size: 13px; color: var(--muted); transition: color .15s; }
    .footer-links a:hover { color: var(--text); }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      nav { padding: 0 20px; }
      .nav-links { display: none; }
      section { padding: 64px 20px; }
      .steps, .features-grid, .pricing-grid, .testimonials-grid { grid-template-columns: 1fr; }
      .stats-inner { grid-template-columns: repeat(2, 1fr); }
      .trust-inner { gap: 20px; }
      .download-cta { padding: 64px 20px; }
      footer { padding: 32px 20px; flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
