# Copy to .env and fill in values — never commit .env

# App
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinelcore

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Threat Intel APIs (get free keys at virustotal.com and otx.alienvault.com)
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# Stripe billing (dashboard.stripe.com → API keys + Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate limiting
FREE_TIER_SCANS_PER_DAY=5
PRO_TIER_SCANS_PER_DAY=10000

# File upload
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=/tmp/sentinel_uploads
