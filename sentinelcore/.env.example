# SentinelCore — Environment Variables
# Copy to .env and fill in values. Never commit .env.
#
# For local dev:  service hostnames are localhost / 127.0.0.1
# For production: server-setup.sh auto-generates secrets and patches URLs
#                 to Docker service names (db, redis).

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Domain (production only) ──────────────────────────────────────────────────
DOMAIN=yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Dev:  postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinelcore
# Prod: postgresql+asyncpg://sentinel:POSTGRES_PASSWORD@db:5432/sentinelcore
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinelcore
POSTGRES_PASSWORD=sentinel

# ── Redis ─────────────────────────────────────────────────────────────────────
# Dev:  redis://localhost:6379/0
# Prod: redis://:REDIS_PASSWORD@redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Celery ────────────────────────────────────────────────────────────────────
# Dev:  redis://localhost:6379/1
# Prod: redis://:REDIS_PASSWORD@redis:6379/1
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Threat Intel APIs ─────────────────────────────────────────────────────────
# Free keys at virustotal.com and otx.alienvault.com
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# ── Email notifications (Resend — resend.com) ─────────────────────────────────
# Free tier: 3,000 emails/month. Get key at resend.com/api-keys
# Set APP_BASE_URL to your public domain so scan links in emails work
RESEND_API_KEY=re_...
EMAIL_FROM=SentinelCore <alerts@yourdomain.com>
APP_BASE_URL=https://yourdomain.com

# ── MISP integration (Enterprise tier) ───────────────────────────────────────
# Your MISP instance URL and API key (Profile → Auth keys in MISP UI)
MISP_URL=https://your-misp.example.com
MISP_KEY=
MISP_VERIFY_SSL=true

# ── Stripe ────────────────────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys + Webhooks
# Use sk_test_... / whsec_test_... for dev; sk_live_... for prod
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Rate limiting ─────────────────────────────────────────────────────────────
FREE_TIER_SCANS_PER_DAY=5
PRO_TIER_SCANS_PER_DAY=10000

# ── File upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=/tmp/sentinel_uploads
